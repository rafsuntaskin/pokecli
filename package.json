{
  "name": "pokecli",
  "version": "0.1.3",
  "description": "A local CLI wrapper that watches one tmux-backed AI agent session and pokes it with scheduled responses.",
  "type": "module",
  "bin": {
    "poke": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && node scripts/chmod-bin.mjs",
    "pack:release": "npm run build && npm pack",
    "release:local": "node scripts/release-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "version": "node scripts/bump-readme.mjs"
  },
  "keywords": [
    "cli",
    "tmux",
    "agent",
    "automation",
    "claude",
    "codex"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
